rules_version = '2';
// Règles de sécurité WHATMOOD
// Principe : chacun n'écrit QUE ses propres données ; les profils publics et les groupes
// sont lisibles par tout utilisateur connecté.
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn()   { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isHex(c)     { return c is string && c.matches('^#[0-9a-f]{6}$'); }
    function validCode(c) { return c is string && c.matches('^[a-z0-9-]{1,32}$'); }
    function validName(n) { return n is string && n.size() >= 1 && n.size() <= 30; }
    function myUsername() {
      return get(/databases/$(db)/documents/users/$(request.auth.uid)).data.username;
    }

    // Compte privé (pseudo figé à la création)
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['username', 'createdAt', 'color'])
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[a-z0-9_.-]{3,20}$')
        && request.auth.token.email == request.resource.data.username + '@duo-couleur.app';
      allow update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['username', 'createdAt', 'color'])
        && request.resource.data.username == resource.data.username
        && isHex(request.resource.data.color);
      allow delete: if false;

      // Mes groupes (historique privé)
      match /rooms/{code} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validCode(code)
          && request.resource.data.keys().hasOnly(['code', 'lastJoined', 'name'])
          && request.resource.data.code == code
          && request.resource.data.lastJoined == request.time
          && (!('name' in request.resource.data) || validName(request.resource.data.name));
      }

      // Mes amis — amitié RÉCIPROQUE, créée uniquement en acceptant une demande.
      // B accepte la demande de A : B écrit users/B/friends/A ET users/A/friends/B dans le même lot.
      // (on peut aussi s'ajouter soi-même pour voir son rendu)
      match /friends/{fid} {
        allow read: if isOwner(uid);
        allow delete: if isOwner(uid) || (signedIn() && request.auth.uid == fid);   // chacun peut rompre
        allow create: if exists(/databases/$(db)/documents/profiles/$(fid))
          && request.resource.data.keys().hasOnly(['name', 'lastSeen', 'room'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 20
          && request.resource.data.lastSeen == request.time
          && (!('room' in request.resource.data) || validCode(request.resource.data.room))
          && (
            (isOwner(uid) && (fid == uid || exists(/databases/$(db)/documents/requests/$(uid)/items/$(fid))))
            || (signedIn() && request.auth.uid == fid
                && exists(/databases/$(db)/documents/requests/$(fid)/items/$(uid))
                && request.resource.data.name == myUsername())
          );
        allow update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['name', 'lastSeen', 'room'])
          && request.resource.data.lastSeen == request.time;
      }
    }

    // Profil public : pseudo, couleur, lieu, activité, envie, statut, disponibilité, police, contour — visible par les connectés
    match /profiles/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['username', 'color', 'mood', 'place', 'act', 'wish', 'status', 'avail', 'font', 'edge', 'st', 'music', 'musicUrl'])
        && request.resource.data.username == myUsername()
        && isHex(request.resource.data.color)
        && (!('mood' in request.resource.data)   || (request.resource.data.mood is string && request.resource.data.mood.size() <= 16))
        && (!('status' in request.resource.data) || (request.resource.data.status is string && request.resource.data.status.size() <= 60))
        && (!('avail' in request.resource.data)  || request.resource.data.avail in ['', 'dispo', 'occupe', 'dnd'])
        && (!('font' in request.resource.data)   || request.resource.data.font in ['inter','bebas','bungee','righteous','orbitron','marker','pacifico','caveat','playfair','monoton','pixel'])
        && (!('place' in request.resource.data)  || request.resource.data.place in ['', 'maison','metro','bar','parc','ecole','ville','campagne','travail','resto','cafe','sport','plage','concert','cine','voyage','route','montagne','soiree','shopping','dodo'])
        && (!('act' in request.resource.data)    || request.resource.data.act in ['', 'after','shopping','bouffe','dodo','dancing','working','sport','musique','apero','gaming','lecture','chill'])
        && (!('wish' in request.resource.data)   || request.resource.data.wish in ['', 'sortir','boire','manger','danser','fete','monde','chiller','dormir','rentrer','bouger','calin','voyager','saispas'])
        && (!('st' in request.resource.data) || request.resource.data.st == request.time
            || (resource != null && ('st' in resource.data) && request.resource.data.st == resource.data.st))
        && (!('music' in request.resource.data)    || (request.resource.data.music is string && request.resource.data.music.size() <= 28))
        && (!('musicUrl' in request.resource.data) || request.resource.data.musicUrl == ''
            || (request.resource.data.musicUrl is string && request.resource.data.musicUrl.size() <= 300
                && request.resource.data.musicUrl.matches('https://(open[.]spotify[.]com|spotify[.]link|soundcloud[.]com|on[.]soundcloud[.]com|m[.]soundcloud[.]com|www[.]youtube[.]com|youtube[.]com|m[.]youtube[.]com|youtu[.]be|music[.]youtube[.]com|www[.]deezer[.]com|deezer[.]page[.]link|link[.]deezer[.]com|music[.]apple[.]com)/.*')))
        && (!('edge' in request.resource.data)   || request.resource.data.edge == '' || isHex(request.resource.data.edge));
      allow delete: if false;
    }

    // Position partagée : lisible UNIQUEMENT par son propriétaire et par les personnes
    // que le propriétaire a lui-même ajoutées en amis.
    match /locs/{uid} {
      allow read: if isOwner(uid)
        || (signedIn() && exists(/databases/$(db)/documents/users/$(uid)/friends/$(request.auth.uid)));
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['lat', 'lng', 'label', 'prec', 't'])
        && request.resource.data.lat is number && request.resource.data.lat >= -90  && request.resource.data.lat <= 90
        && request.resource.data.lng is number && request.resource.data.lng >= -180 && request.resource.data.lng <= 180
        && request.resource.data.label is string && request.resource.data.label.size() <= 60
        && request.resource.data.prec in ['quartier', 'precise']
        && request.resource.data.t == request.time;
      allow delete: if isOwner(uid);
    }

    // Demandes d'ami : requests/{destinataire}/items/{expéditeur}
    match /requests/{to}/items/{from} {
      allow read: if isOwner(to) || isOwner(from);
      allow create: if signedIn() && request.auth.uid == from && from != to
        && exists(/databases/$(db)/documents/profiles/$(to))
        && request.resource.data.keys().hasOnly(['fromName', 't'])
        && request.resource.data.fromName == myUsername()
        && request.resource.data.t == request.time;
      allow delete: if isOwner(to) || isOwner(from);       // refuser / annuler
    }

    // Groupe : nom figé à la création
    match /rooms/{code} {
      allow read: if signedIn() && validCode(code);
      allow create: if signedIn() && validCode(code)
        && request.resource.data.keys().hasOnly(['name', 'createdBy', 'createdAt'])
        && validName(request.resource.data.name)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;

      // Présence des joueurs dans le groupe
      match /members/{uid} {
        allow read: if signedIn() && validCode(code);
        allow create, update: if isOwner(uid) && validCode(code)
          && request.resource.data.keys().hasOnly(['name', 'color', 't', 'online'])
          && request.resource.data.name == myUsername()
          && isHex(request.resource.data.color)
          && request.resource.data.online is bool
          && request.resource.data.t == request.time;
        allow delete: if isOwner(uid);
      }
    }

    // Invitations reçues : n'importe quel connecté peut inviter quelqu'un d'autre,
    // sous son vrai pseudo ; seul le destinataire peut les lire / supprimer.
    match /invites/{uid}/items/{code} {
      allow read, delete: if isOwner(uid);
      allow create, update: if signedIn() && uid != request.auth.uid && validCode(code)
        && request.resource.data.keys().hasOnly(['fromUid', 'fromName', 'groupName', 't'])
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.fromName == myUsername()
        && validName(request.resource.data.groupName)
        && request.resource.data.t == request.time;
    }
  }
}
